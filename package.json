{
  "name": "wechat-feishu-message-analysis-dashboard",
  "version": "1.2.0",
  "private": true,
  "packageManager": "pnpm@11.16.0",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "db:backup": "node scripts/backup-cockpit-db.mjs",
    "privacy:harden": "node scripts/reader/harden-permissions.mjs",
    "priority:verify": "node scripts/verify-priority-policy.mjs",
    "keyword:verify": "node scripts/verify-keyword-tracking.mjs",
    "priority:verify:live": "node scripts/verify-priority-workspace.mjs",
    "intelligence:verify": "node scripts/verify-intelligence.mjs",
    "feishu:verify": "node scripts/verify-feishu-sync-policy.mjs",
    "reader:inspect": "node scripts/reader/inspect-reader.mjs",
    "service:uninstall": "node scripts/install-dashboard-service.mjs --uninstall",
    "skill:check": "node scripts/install-agent-skills.mjs --check",
    "skill:check:codex": "node scripts/install-agent-skills.mjs --check --codex-only",
    "skill:install": "node scripts/install-agent-skills.mjs",
    "skill:install:codex": "node scripts/install-agent-skills.mjs --codex-only",
    "skill:verify:transfer": "node scripts/verify-skill-transfer.mjs",
    "package:transfer": "node scripts/package-transfer.mjs",
    "session:start": "node skills/wechat-dashboard/scripts/dashboard-bridge.mjs start",
    "session:open": "node skills/wechat-dashboard/scripts/dashboard-bridge.mjs open",
    "session:status": "node skills/wechat-dashboard/scripts/dashboard-bridge.mjs status",
    "session:stop": "node skills/wechat-dashboard/scripts/dashboard-bridge.mjs stop",
    "session:verify": "node scripts/verify-session-runtime.mjs",
    "security:verify": "node scripts/verify-private-paths.mjs",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint"
  },
  "dependencies": {
    "@jackwener/wx-cli": "0.3.0",
    "@larksuite/cli": "1.0.84",
    "better-sqlite3": "^12.10.0",
    "echarts": "^6.1.0",
    "echarts-for-react": "^3.0.6",
    "lucide-react": "^1.16.0",
    "next": "16.2.11",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.11",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "description": "Private local macOS dashboard for WeChat and Feishu group and private message analysis",
  "license": "MIT"
}
