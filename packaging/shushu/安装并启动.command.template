#!/bin/zsh
set -euo pipefail

SCRIPT_DIR="${0:A:h}"
PROJECT_DIR="$SCRIPT_DIR/WeChat-Dashboard"

function fail() {
  print -u2 "\n安装停止：$1"
  print -u2 "请保留本窗口，并把上面的错误交给 Codex 处理。"
  read -r "?按回车关闭窗口…"
  exit 1
}

[[ "$(uname -s)" == "Darwin" ]] || fail "只支持 macOS。"
[[ -f "$PROJECT_DIR/package.json" ]] || fail "找不到 WeChat-Dashboard/package.json，请完整解压移交包。"

if ! command -v node >/dev/null 2>&1; then
  fail "没有找到 Node.js。请先安装 Node.js 20 或更高版本，再重新运行本脚本。"
fi

NODE_MAJOR="$(node -p 'Number(process.versions.node.split(".")[0])')"
(( NODE_MAJOR >= 20 )) || fail "Node.js 版本过低，至少需要 20；当前版本为 $(node --version)。"

if ! command -v pnpm >/dev/null 2>&1; then
  if command -v corepack >/dev/null 2>&1; then
    print "正在通过 Corepack 准备 pnpm 11.16.0…"
    corepack prepare pnpm@11.16.0 --activate || fail "Corepack 无法准备 pnpm。"
  elif command -v npm >/dev/null 2>&1; then
    print "未找到 pnpm。将通过 npm 安装 pnpm 11.16.0。"
    read -r "REPLY?继续安装 pnpm？[y/N] "
    [[ "$REPLY" == [yY] ]] || fail "用户取消了 pnpm 安装。"
    npm install --global pnpm@11.16.0 || fail "pnpm 安装失败。"
  else
    fail "没有找到 pnpm、Corepack 或 npm。"
  fi
fi

cd "$PROJECT_DIR"

print "\n[1/7] 安装锁定依赖…"
pnpm install --frozen-lockfile || fail "依赖安装失败，请检查网络或 Node.js 环境。"

print "\n[2/7] 重建当前 Mac 的 SQLite 原生模块…"
pnpm rebuild better-sqlite3 || fail "better-sqlite3 重建失败。"

print "\n[3/7] 收紧本地隐私目录权限…"
pnpm privacy:harden || fail "隐私目录权限检查失败。"

print "\n[4/7] 检查微信读取器可执行文件…"
pnpm reader:inspect || fail "wx-cli 读取器未能安装或执行。"

print "\n[5/7] 构建 production Dashboard…"
pnpm build || fail "Dashboard 构建失败。"

print "\n[6/7] 安装 Codex 与 Claude Code Skill…"
pnpm skill:install || fail "Agent Skill 安装失败。"
pnpm skill:check || fail "Agent Skill 安装后检查失败。"

print "\n[7/7] 启动本机临时 Dashboard…"
pnpm session:start || fail "Dashboard 启动失败。"

open "http://127.0.0.1:3000/setup"

print "\n安装与构建完成。"
print "下一步：在 /setup 检查这台 Mac 自己的微信读取器和账号状态。"
print "之后在 Codex 中输入：\$wechat-dashboard"
print "安装过程没有重启、重签、退出或修改微信。"
read -r "?按回车关闭窗口…"
