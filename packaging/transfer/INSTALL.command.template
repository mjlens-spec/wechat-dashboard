#!/bin/zsh
set -euo pipefail

SCRIPT_DIR="${0:A:h}"
PROJECT_DIR="$SCRIPT_DIR/wechat-feishu-message-analysis-dashboard"

function fail() {
  print -u2 "\n安装停止：$1"
  print -u2 "请保留本窗口，并把上面的错误交给 Codex 处理。"
  read -r "?按回车关闭窗口…"
  exit 1
}

[[ "$(uname -s)" == "Darwin" ]] || fail "只支持 macOS。"
[[ -f "$PROJECT_DIR/package.json" ]] || fail "找不到完整项目，请重新解压整个移交包。"

command -v node >/dev/null 2>&1 || fail "没有找到 Node.js。请先安装 Node.js 20 或更高版本。"
NODE_MAJOR="$(node -p 'Number(process.versions.node.split(".")[0])')"
(( NODE_MAJOR >= 20 )) || fail "Node.js 版本过低，至少需要 20；当前版本为 $(node --version)。"

if ! command -v pnpm >/dev/null 2>&1; then
  if command -v corepack >/dev/null 2>&1; then
    print "正在通过 Corepack 准备 pnpm 11.16.0…"
    corepack prepare pnpm@11.16.0 --activate || fail "Corepack 无法准备 pnpm。"
  else
    fail "没有找到 pnpm 或 Corepack。"
  fi
fi

if ! command -v lark-cli >/dev/null 2>&1; then
  print "\n[1/8] 安装飞书官方 lark-cli 1.0.84…"
  npx --yes @larksuite/cli@1.0.84 install || fail "lark-cli 安装失败。"
else
  print "\n[1/8] 飞书 CLI 已安装：$(lark-cli --version)"
fi

cd "$PROJECT_DIR"

print "\n[2/8] 安装锁定依赖…"
pnpm install --frozen-lockfile || fail "依赖安装失败，请检查网络或 Node.js 环境。"

print "\n[3/8] 重建当前 Mac 的 SQLite 原生模块…"
pnpm rebuild better-sqlite3 || fail "better-sqlite3 重建失败。"

print "\n[4/8] 收紧本地隐私目录权限…"
pnpm privacy:harden || fail "隐私目录权限检查失败。"

print "\n[5/8] 检查微信读取器…"
pnpm reader:inspect || print "微信读取器尚未就绪；稍后按 CONNECT_WECHAT_FEISHU.md 逐机配置。"

print "\n[6/8] 构建 production Dashboard…"
pnpm build || fail "Dashboard 构建失败。"

print "\n[7/8] 安装 Codex 与 Claude Code Skill…"
pnpm skill:install || fail "Agent Skill 安装失败。"
pnpm skill:check || fail "Agent Skill 安装后检查失败。"

print "\n[8/8] 启动本机临时 Dashboard…"
pnpm session:start || fail "Dashboard 启动失败。"

open "http://127.0.0.1:3000/setup"

print "\n代码、依赖、构建和 Skill 安装已经完成。"
print "下一步：按照 CONNECT_WECHAT_FEISHU.md 完成这台 Mac 自己的微信读取器与飞书用户授权。"
print "之后在 Codex 中输入：\$wechat-dashboard"
read -r "?按回车关闭窗口…"
