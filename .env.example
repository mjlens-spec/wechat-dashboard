# Optional absolute path to the frozen local wx 0.3.0 executable.
# The Dashboard never downloads, initializes, re-signs, or upgrades the reader.
WECHAT_DASHBOARD_WX_BIN=

# Optional comma-separated names used by the later local rule engine.
WECHAT_DASHBOARD_MY_NAMES=

# Set to 1 only when reviewing the interface without real WeChat data.
WECHAT_DASHBOARD_DEMO=0

# Normal macOS use stores the 32-byte master key in Keychain automatically.
# WECHAT_DASHBOARD_MASTER_KEY is reserved for isolated automated tests and must
# be a base64-encoded 32-byte value. Never commit a real value.
